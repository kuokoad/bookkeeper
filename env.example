# ---------------------------------------------------------------------------
# Template. Run `npm run env:init` to generate a real `.env` with a fresh
# random SESSION_SECRET. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Where the shop's SQLite database file lives, relative to the project root.
# Back this file up. It IS the business records.
DATABASE_PATH=./data/bookkeeper.db

# Secret used to derive session material. 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real value. NEVER reuse this placeholder.
SESSION_SECRET=replace-me-with-a-64-char-random-hex-string

# "development" | "production"
NODE_ENV=development

# Seed clearly-marked DEMO data (products, sales, suppliers) for development.
# Must be "false" for a real shop. Demo rows are tagged is_demo=1 and purgeable.
SEED_DEMO_DATA=true

# Mark the session cookie `Secure` so it is only sent over HTTPS.
# Leave false when the shop runs over plain HTTP on its own network — `Secure`
# would stop the cookie being sent at all and nobody could sign in.
# Set to true the moment the app is put behind HTTPS.
COOKIE_SECURE=false
